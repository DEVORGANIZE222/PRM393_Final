rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isRosterMember() {
      return request.auth != null
          && exists(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email));
    }

    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
          ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          : 'user';
    }

    function isStaff() {
      return isAdmin();
    }

    function isAdmin() {
      return request.auth != null && getUserRole() == 'admin';
    }

    // A lecturer is a roster entry that an admin linked to a `mentors` document.
    function myMentorId() {
      return isRosterMember()
          ? get(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email)).data.get('mentorId', null)
          : null;
    }

    // --- Role-Based Access Control (Appendix A & B) ---

    // Web administration has one privileged role: admin. Roles are assigned
    // only through the Firebase Console during bootstrap, never by the web UI.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isStaff());
      allow create: if request.auth != null && request.auth.uid == userId
          && request.resource.data.role == 'user';
      allow update: if isAdmin()
          && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // events/{id}: Staff/Admin manage events; all signed-in users read published events.
    match /events/{eventId} {
      allow read: if request.auth != null && (resource.data.status == 'published' || isStaff());
      allow create, update: if isStaff();
      allow delete: if false; // soft delete / archive instead
    }

    // A leader submits an already locked roster. Only admins can make the
    // pending -> approved/rejected decision; rejection must explain why.
    match /teamSubmissions/{teamId} {
      allow create: if isRosterMember()
          && request.resource.data.keys().hasAll([
            'teamId', 'leaderId', 'teamName', 'lockCode', 'memberSnapshot',
            'status', 'submittedAt', 'reason'
          ])
          && request.resource.data.teamId == teamId
          && request.resource.data.leaderId == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.reason == ''
          && exists(/databases/$(database)/documents/teams/$(teamId))
          && get(/databases/$(database)/documents/teams/$(teamId)).data.locked == true
          && get(/databases/$(database)/documents/teams/$(teamId)).data.leaderId == request.auth.uid;
      allow read: if isAdmin()
          || (isRosterMember() && resource.data.leaderId == request.auth.uid);
      allow update: if isAdmin()
          && resource.data.status == 'pending'
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'reason', 'reviewedAt', 'reviewedBy'
          ])
          && (request.resource.data.status == 'approved'
              || request.resource.data.reason is string
                  && request.resource.data.reason.size() > 0);
      allow delete: if false;
    }

    // announcements/{id}: Staff broadcast announcements; mobile reads in inbox.
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isStaff();
    }

    // The app reads only its own roster entry during sign-in. Listing the
    // class roster is deliberately denied so student emails are not exposed.
    match /allowedEmails/{email} {
      allow get: if request.auth != null && request.auth.token.email == email;
      // Admin imports and maintains the roster/Google allowlist. Extra roster
      // metadata is ignored by mobile authentication, which reads `enabled`.
      allow list, create, update, delete: if isAdmin();
    }

    match /students/{userId} {
      allow read: if (isRosterMember() && request.auth.uid == userId) || isAdmin();
      allow create, update: if isRosterMember() && request.auth.uid == userId;
      allow delete: if false;
      match /notifications/{notificationId} {
        allow read, write: if (isRosterMember() && request.auth.uid == userId) || isAdmin();
        // A lecturer tells the leader their answer, in the same transaction.
        allow create: if myMentorId() != null
            && getAfter(/databases/$(database)/documents/mentor_requests/$(request.resource.data.teamId)).data.mentorId == myMentorId()
            && getAfter(/databases/$(database)/documents/mentor_requests/$(request.resource.data.teamId)).data.senderId == userId
            && getAfter(/databases/$(database)/documents/mentor_requests/$(request.resource.data.teamId)).data.status != 'pending';
      }
    }

    match /teams/{teamId} {
      allow read: if isRosterMember() || isAdmin();

      // Only roster members who are currently on the team (or joining it) may
      // update a team document. Each mutation type (join, leave, vote, lock, pool invite)
      // is validated individually against before/after state.
      allow update: if (isRosterMember() && isValidTeamUpdate()) || isMentorAccept();
      allow create: if isRosterMember()
          && request.resource.data.memberIds.size() == 1
          && request.resource.data.memberIds[0] == request.auth.uid
          && request.resource.data.locked == false;
      allow delete: if false;

      // The lecturer a team asked becomes its mentor. Works on locked teams too:
      // choosing a mentor does not touch the roster. The request must turn
      // approved in the same transaction, so nobody can claim a team unasked.
      function isMentorAccept() {
        let accepted = getAfter(/databases/$(database)/documents/mentor_requests/$(teamId)).data;
        return myMentorId() != null
            && resource.data.get('mentorId', null) == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mentorId', 'supervisor'])
            && request.resource.data.mentorId == myMentorId()
            && accepted.mentorId == myMentorId()
            && accepted.status == 'approved'
            && request.resource.data.supervisor == accepted.mentorName;
      }

      function isValidTeamUpdate() {
        let uid = request.auth.uid;
        let before = resource.data;
        let after = request.resource.data;

        // Document must retain all required top-level fields
        let hasRequiredFields = after.keys().hasAll(['members', 'memberIds', 'votes', 'locked', 'invitesSent']);

        // GR-01: students may only change roster state, never the team's
        // metadata (name, topic, capacity, supervisor, tags...).
        let onlyRosterFields = after.diff(before).affectedKeys().hasOnly(
            ['members', 'memberIds', 'votes', 'leaderId', 'locked', 'lockCode', 'lockedAt', 'invitesSent', 'openRoles']);

        let isUnlock = isLeaderUnlock(uid, before, after);

        return hasRequiredFields && onlyRosterFields && (
          isUnlock || (
            before.locked == false && (
              isSelfJoin(uid, before, after) ||
              isSelfLeave(uid, before, after) ||
              isSelfVote(uid, before, after) ||
              isLeaderLock(uid, before, after) ||
              isLeaderPoolInvite(uid, before, after) ||
              isLeaderRosterUpdate(uid, before, after)
            )
          )
        );
      }

      function isLeaderUnlock(uid, before, after) {
        return before.leaderId == uid
            && after.leaderId == uid
            && before.locked == true
            && after.locked == false
            && after.memberIds == before.memberIds;
      }

      function isLeaderRosterUpdate(uid, before, after) {
        return before.leaderId == uid
            && after.leaderId == uid
            && after.locked == false;
      }

      function isSelfJoin(uid, before, after) {
        return !(uid in before.memberIds)
            && (uid in after.memberIds)
            && after.members.size() == before.members.size() + 1
            && after.votes == before.votes
            && after.locked == before.locked
            && after.leaderId == before.leaderId
            && after.invitesSent == before.invitesSent;
      }

      function isSelfLeave(uid, before, after) {
        return (uid in before.memberIds)
            && !(uid in after.memberIds)
            && after.members.size() == before.members.size() - 1
            && after.locked == before.locked
            && after.invitesSent == before.invitesSent;
      }

      function isSelfVote(uid, before, after) {
        return (uid in before.memberIds)
            && (uid in after.memberIds)
            && after.members == before.members
            && after.memberIds == before.memberIds
            && after.locked == before.locked
            && after.invitesSent == before.invitesSent
            && (after.votes[uid] in before.memberIds);
      }

      function isLeaderLock(uid, before, after) {
        return before.leaderId == uid
            && after.leaderId == uid
            && after.locked == true
            && before.members.size() >= 4
            && after.members == before.members
            && after.memberIds == before.memberIds;
      }

      function isLeaderPoolInvite(uid, before, after) {
        return before.leaderId == uid
            && after.leaderId == uid
            && after.invitesSent == before.invitesSent + 1
            && after.members.size() == before.members.size() + 1
            && after.locked == false;
      }
    }

    match /waitingPool/{userId} {
      // Students can read their own pool record. Team leaders must also see
      // unassigned candidates: inviteFromPool queries `assigned == false` and
      // re-reads the chosen record inside its transaction. Assigned records
      // stay private to their owner.
      allow get: if isAdmin() || (isRosterMember()
                    && (request.auth.uid == userId || resource.data.assigned == false));
      allow list: if isAdmin() || (isRosterMember() && resource.data.assigned == false);

      // Only the verified leader of assignedTeamId can mark a pool student as assigned (via inviteFromPool).
      allow update: if isRosterMember()
                    && resource.data.assigned == false
                    && request.resource.data.assigned == true
                    && request.resource.data.keys().hasAll(['assigned', 'assignedTeamId'])
                    && isLeaderOf(request.resource.data.assignedTeamId);
      allow create, delete: if false;

      function isLeaderOf(teamId) {
        return exists(/databases/$(database)/documents/teams/$(teamId))
            && get(/databases/$(database)/documents/teams/$(teamId)).data.leaderId == request.auth.uid;
      }
    }

    // Lecturer profiles come from the seed (tool/seed_firestore_lab3.py).
    // `currentAssigned` and the team list only move when the lecturer accepts
    // a team, one at a time and within quota.
    match /mentors/{mentorId} {
      allow read: if isRosterMember() || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
                    || (myMentorId() == mentorId
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentAssigned', 'mentoredTeamNames'])
                        && request.resource.data.currentAssigned == resource.data.currentAssigned + 1
                        && request.resource.data.currentAssigned <= resource.data.maxQuota);
    }

    // One document per team (id = team id): a team asks one mentor at a time.
    match /mentor_requests/{teamId} {
      function team() {
        return get(/databases/$(database)/documents/teams/$(teamId)).data;
      }

      function isValidNewRequest() {
        let after = request.resource.data;
        return team().leaderId == request.auth.uid
            && team().get('mentorId', null) == null
            && after.teamId == teamId
            && after.senderId == request.auth.uid
            && after.status == 'pending'
            && get(/databases/$(database)/documents/mentors/$(after.mentorId)).data.get('status', 'active') != 'archived';
      }

      function isMentorDecision() {
        return resource.data.status == 'pending'
            && resource.data.mentorId == myMentorId()
            && request.resource.data.status in ['approved', 'rejected']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decisionReason', 'decidedAt']);
      }

      allow read: if isRosterMember() || isAdmin();
      allow create: if isRosterMember() && isValidNewRequest();
      // After a refusal the team's next request replaces the old one.
      allow update: if isMentorDecision()
                    || (isRosterMember() && resource.data.status == 'rejected' && isValidNewRequest());
      allow delete: if isRosterMember() && resource.data.status == 'pending' && team().leaderId == request.auth.uid;
    }

    match /configuration/{document} {
      allow read: if isRosterMember() || isAdmin();
      // configuration/registration is the public-to-students projection of
      // the active semester. Admin writes preserve its existing field names.
      allow write: if isAdmin();
    }

    // Semester management is web-admin only. The active semester is projected
    // to configuration/registration for the mobile client.
    match /semesters/{semesterId} {
      allow read: if isRosterMember() || isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
